.env*
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
credentials.json
*service-account*.json
*firebase-adminsdk*.json

# Local reference material and QA are not part of the shipped application.
/artifacts/
/tests/
/scripts/
/supabase/
/docs/
/playwright-report/
/test-results/
/blob-report/
/playwright.config.ts
/tsconfig.tests.json
/.github/
/legal-site/
/sources/
/*.txt
**/*.md
