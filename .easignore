.expo/
dist/
.logs/
.cache/
web-build/
expo-env.d.ts
/ios/
/android/
.kotlin/
.metro-health-check*
*.tsbuildinfo
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

