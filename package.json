{
  "name": "arca-mobile",
  "version": "0.3.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.29",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:report": "playwright show-report",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "energy:config": "node --experimental-strip-types scripts/generate-energy-config.mjs",
    "energy:config:check": "node --experimental-strip-types scripts/generate-energy-config.mjs --check",
    "energy:sql": "node scripts/package-battery-sql.mjs",
    "energy:preview": "node --experimental-strip-types scripts/battery-preview.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test:all",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.ts"
  },
  "private": true,
  "type": "module"
}
